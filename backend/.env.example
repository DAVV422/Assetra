PORT=4000
CORS_ORIGIN=http://localhost:5173
ASSETRA_MODE=mock
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
RWA_REGISTRY_CONTRACT_ID=

# Límite de peticiones por IP (0 desactiva)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=30
# Proxies delante de la API (Koyeb: 1). Con 0 se usa la IP de conexión directa.
TRUST_PROXY=0

# Metadatos del catálogo en modo live (nombres, descripciones, participantes, actividad).
# Con DATABASE_URL o DATABASE_HOST se usa PostgreSQL; sin ellas, el archivo data/chain-assets.json
# (se pierde en plataformas con disco efímero como Koyeb).
DATABASE_URL=
# Alternativa por partes (nombres que usa Koyeb al vincular su base de datos):
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_NAME=
# TLS obligatorio con verificación de certificado; usa "disable" solo con un Postgres local.
DATABASE_SSL=require
